# Dashboard origin. Default in the skill and helper is https://aiberm.com.
NEW_API_BASE_URL=https://aiberm.com

# System access token from the dashboard (系统访问令牌). Not an sk- relay key.
NEW_API_ACCESS_TOKEN=

# Numeric user id. Sent as New-Api-User. Not a username.
NEW_API_USER_ID=

# Quota units per 1 USD. New API's usual default is 500000.
NEW_API_QUOTA_PER_UNIT=500000
