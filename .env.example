# New API origin. Paths such as /api/user/self are appended to this origin.
NEW_API_BASE_URL=https://aiberm.com

# Dashboard system access token (个人设置 → 系统访问令牌). Not an sk- relay key.
NEW_API_ACCESS_TOKEN=

# Numeric user id. Must match the account that owns the access token.
NEW_API_USER_ID=

# Optional. New API default is 500000 quota = 1 USD. Override if the site changed QuotaPerUnit.
# NEW_API_QUOTA_PER_UNIT=500000

# Optional HTTP transport. stdio is the default.
# MCP_TRANSPORT=http
# PORT=3000
# MCP_HTTP_HOST=127.0.0.1
